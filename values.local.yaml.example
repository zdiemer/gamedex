# Copy to values.local.yaml and fill in. values.local.yaml is gitignored.

dropbox:
  # PREFERRED: a direct shared link to the .xlsx FILE itself.
  # In Dropbox: right-click "Games Master List - Final.xlsx" -> Copy link.
  #   https://www.dropbox.com/scl/fi/<id>/Games-Master-List-Final.xlsx?rlkey=<key>&dl=0
  # This downloads only the ~2.5 MB workbook on each poll.
  url: "https://www.dropbox.com/scl/fi/XXXXXXXX/Games-Master-List-Final.xlsx?rlkey=XXXXXXXX&dl=0"

  # ALSO SUPPORTED: a FOLDER link (…/scl/fo/…). The app downloads the folder as
  # a zip and extracts `filename` from it — simpler to share, but pulls the
  # whole folder every poll, so prefer the file link above for a big folder.
  # filename: "Games Master List - Final.xlsx"

# IGDB (Twitch) credentials for metadata enrichment. Create an app at
# https://dev.twitch.tv/console/apps — same key you use for RomM works.
igdb:
  clientId: "CHANGE-ME"
  clientSecret: "CHANGE-ME"

# Optional — GameSpot API key (https://www.gamespot.com/api/) for the fallback
# metadata chain. IGN + Steam fallbacks work without it.
gamespot:
  apiKey: ""

# Optional — IsThereAnyDeal API key (free, register an app at
# https://isthereanydeal.com/apps/) for wishlist prices, discounts and all-time
# lows on the Wishlist tab. Off unless a key is set.
itad:
  apiKey: ""            # the plain "Key" from https://isthereanydeal.com/apps/my/
  clientId: ""          # OAuth Client ID (fallback if apiKey is blank)
  clientSecret: ""      # OAuth Client Secret (future user-auth features)
  country: "US"

# Optional — ScreenScraper, for real scanned box art on the Shelf (front, back and
# spine as separate images) plus cartridge/disc scans and manuals. BOTH pairs matter:
# the developer key is what unlocks the API at all (request one on their forum), the
# account raises the daily quota and the resolution of what you get back.
screenscraper:
  devId: ""
  devPassword: ""
  user: ""              # your screenscraper.fr account
  password: ""

# Single-admin login. Seeds ONE account on first boot (when the accounts DB is
# empty). Set a strong initial password, log in, then change it in-app — changing
# it here afterward does nothing. Blank initialPassword = login disabled.
admin:
  username: "zachd"
  initialPassword: "CHANGE-ME-to-a-strong-random-password"
